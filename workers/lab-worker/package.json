{
  "name": "@university-lms/lab-worker",
  "version": "0.11.0",
  "private": true,
  "description": "Isolated lab code execution worker — NEVER run untrusted code in apps/api",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}
