# ===========================================
# University LMS — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env
# ===========================================

NODE_ENV=development

# API
PORT=4000
CORS_ORIGIN=http://localhost:5173,https://university-lms-web.vercel.app

# MongoDB (local or Atlas)
# Local (Docker): mongodb://localhost:27017/university_lms
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/university_lms
MONGODB_URI=mongodb://localhost:27017/university_lms

# JWT Secrets (generate strong random strings, min 32 chars)
# Example: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-very-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-very-long-random-string-at-least-32

# Redis (optional for Phase 1, required later for queues/cache)
REDIS_URL=redis://localhost:6379

# Public app URL (used in verification + password-reset email links)
APP_URL=http://localhost:5173

# Email (Resend). Optional in development — logs [DEV MAIL] when unset.
# EMAIL_PROVIDER_API_KEY=re_xxxxxxxx
# EMAIL_FROM="University LMS <noreply@your-verified-domain.com>"

# Frontend (Vite)
# VITE_API_URL=http://localhost:4000/api/v1
# Demo autofill on login UI — only works when DEV=true AND this is "true"
VITE_ENABLE_DEMO_LOGIN=false

# Phase 3 — Billing (optional; skeleton works without live keys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# Phase 8 — content storage
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=./uploads

# Phase 14 — transcript/certificate signing
TRANSCRIPT_SIGNING_SECRET=change-me-in-production-min-32-chars
