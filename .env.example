# ===========================================
# University LMS — Environment Variables
# Copy this file to .env and fill in the values
# ===========================================

NODE_ENV=development

# API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# MongoDB (local or Atlas)
# Local example: mongodb://localhost:27017/university_lms
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/university_lms
MONGODB_URI=mongodb://localhost:27017/university_lms

# JWT Secrets (generate strong random strings, min 32 chars)
JWT_ACCESS_SECRET=change-me-to-a-very-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-very-long-random-string-at-least-32

# Redis (optional for now, required later for queues/cache)
REDIS_URL=redis://localhost:6379

# Future
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# CLOUDFLARE_R2_...
